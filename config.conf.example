# Strategy filename from data/strategies.
STRATEGY='general.bat'
# any, wlan0, rmnet+ or another iptables interface mask.
INTERFACE=any
FIREWALL=auto
QUEUE_NUM=200
FW_MARK=0x40000000
AUTO_UPDATE=0
UPDATE_HOURS=24
SOURCE=flowseal
LOGGING=1
# loaded: domains + IP lists; domains: hostlists only; all: every destination on strategy ports.
MODE=loaded
ENABLED=1
LOG_MAX_BYTES=2097152
